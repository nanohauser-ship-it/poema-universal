          args={[0.25, 0.72, 12, 24]}
        />

        <meshStandardMaterial
          color="#15171d"
          roughness={0.94}
        />
      </mesh>

      {/* Zapatos */}
      <mesh
        position={[-0.24, -1.04, 0.16]}
