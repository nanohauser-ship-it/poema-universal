========================================================= */

function Motivo({
  universo,
}: {
  universo: UniversoVisual;
}) {
  const color = universo.acento;

  const style = {
    "--motivo": color,
  } as CSSProperties;

  return (
    <div
      aria-hidden="true"
      style={style}
      className={`motivo motivo--${universo.motivo}`}
    >
      <span />
      <span />
      <span />
      <span />
      <span />
      <span />
    </div>
  );
}

