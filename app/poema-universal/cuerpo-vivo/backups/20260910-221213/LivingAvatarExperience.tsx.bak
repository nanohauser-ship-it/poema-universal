'use client';
import dynamic from 'next/dynamic';
import Link from 'next/link';
import { Component, useCallback, useState, type ReactNode } from 'react';
import type { PlaybackReport, PlaybackRequest } from '../components/living-avatar/types';
import { demoRepository, type Contribution, type CeremonyState } from '../components/living-avatar/ceremony';
import FragmentInspector from '../components/living-avatar/FragmentInspector';
import styles from './living-avatar.module.css';
const Scene=dynamic(()=>import('../components/living-avatar/LivingAvatarScene'),{ssr:false});
class SceneBoundary extends Component<{children:ReactNode},{failed:boolean}>{state={failed:false};static getDerivedStateFromError(){return {failed:true}}render(){return this.state.failed?<div className={styles.failure} role="alert"><p>No se pudo abrir el cuerpo 3D.</p><button onClick={()=>location.reload()}>Volver a intentar</button></div>:this.props.children}}
const words:Record<CeremonyState,string>={DORMANT:'La presencia está apareciendo…',IDLE:'TE CORRESPONDE CONTINUAR AQUÍ.',SENSING:'Una voz se acerca.',ATTRACTING:'Las palabras encuentran su camino.',CAPTURING:'El cuerpo escucha.',ABSORBING:'Tu voz entra en el cuerpo.',PULSE:'Un nuevo latido.',INCORPORATING:'Una huella permanece.',REVEAL:'TU FRAGMENTO YA FORMA PARTE DEL CUERPO.',RETURNING:'NADIE LO ESCRIBE SOLO.'};
export default function LivingAvatarExperience(){
 const [ready,setReady]=useState(false),[request,setRequest]=useState<PlaybackRequest|null>(null),[phase,setPhase]=useState<CeremonyState>('DORMANT'),[text,setText]=useState(''),[contribution,setContribution]=useState<Contribution|null>(null),[contributions,setContributions]=useState<Contribution[]>([]),[error,setError]=useState(''),[selected,setSelected]=useState<Contribution|null>(null);
 const onReady=useCallback(()=>{setReady(true);setPhase('IDLE');try{setContributions(demoRepository.getRecentContributions())}catch{setError('No se ha podido leer el archivo de este dispositivo.')}},[]);
 const onReport=useCallback((report:PlaybackReport)=>{if(report.state==='ERROR'){setError('El gesto no pudo completarse. Tu fragmento sigue guardado en este dispositivo.');setPhase('IDLE');setContribution(null)}},[]);
 const onPhase=useCallback((state:CeremonyState)=>{setPhase(state);if(state==='CAPTURING')setRequest(old=>({source:0,serial:(old?.serial??0)+1,inPlace:true}));},[]);
 const busy=phase!=='IDLE'&&phase!=='DORMANT';
 function deposit(event:React.FormEvent){event.preventDefault();if(!ready||busy)return;try{const entry=demoRepository.createContribution(text);setContributions(demoRepository.getRecentContributions());setSelected(null);setContribution(entry);setText('');setError('');setPhase('SENSING')}catch{setError('No se pudo guardar el fragmento. Comprueba que el navegador permita almacenamiento local.')}}
 return <main className={styles.room} data-ceremony={phase}><header className={styles.header}><Link href="/poema-universal">POEMA UNIVERSAL</Link><span>UNA VOZ · UN CUERPO</span></header><div className={`${styles.title} ${busy?styles.quiet:''}`}><span>EL POEMA YA HA COMENZADO.</span><h1>Cuerpo vivo.</h1><p>Una escultura hecha de voces humanas.</p><small>{contributions.length} fragmentos en este dispositivo</small></div><div className={styles.stage} aria-label="Escultura viva que recibe tus palabras"><SceneBoundary><Scene onReady={onReady} request={request} paused={false} onReport={onReport} contribution={contribution} contributions={contributions} onPhase={onPhase} onSelect={setSelected}/></SceneBoundary></div><div className={styles.controls}><p className={styles.playbackStatus} role="status">{words[phase]}</p><form onSubmit={deposit} className={`${styles.composer} ${busy?styles.hiddenComposer:''}`} aria-hidden={busy}><label htmlFor="fragment">Deja unas palabras que merezcan permanecer.</label><textarea id="fragment" placeholder="Escribe tu fragmento…" value={text} onChange={e=>setText(Array.from(e.target.value).slice(0,160).join(''))} disabled={!ready||busy} rows={3}/><div><span>{Array.from(text).length} / 160</span><button type="submit" disabled={!ready||busy||!text.trim()}>DEPOSITAR FRAGMENTO</button></div></form>{!busy&&contributions.length>0&&<button className={styles.memoryButton} onClick={()=>setSelected(contributions[contributions.length-1])}>Leer las huellas del cuerpo</button>}{error&&<p role="alert">{error}</p>}</div><FragmentInspector selected={selected} contributions={contributions} onSelect={setSelected} onClose={()=>setSelected(null)}/><footer className={styles.footer}>DEMOSTRACIÓN LOCAL · LAS VOCES SE GUARDAN EN ESTE DISPOSITIVO</footer></main>
}
