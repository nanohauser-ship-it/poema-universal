'use client';
import dynamic from 'next/dynamic';
import Link from 'next/link';
import { Component, useCallback, useState, type ReactNode } from 'react';
import { AVATAR_SOURCE_FILES } from '../components/living-avatar/config';
import type { PlaybackReport, PlaybackRequest } from '../components/living-avatar/types';
import styles from './living-avatar.module.css';
const Scene=dynamic(()=>import('../components/living-avatar/LivingAvatarScene'),{ssr:false});
class SceneBoundary extends Component<{children:ReactNode},{failed:boolean}>{state={failed:false};static getDerivedStateFromError(){return {failed:true}}render(){return this.state.failed?<div className={styles.failure} role="alert"><p>No se pudo abrir el cuerpo 3D.</p><button onClick={()=>location.reload()}>Volver a intentar</button></div>:this.props.children}}
export default function LivingAvatarExperience(){
 const [ready,setReady]=useState(false),[source,setSource]=useState(0),[request,setRequest]=useState<PlaybackRequest|null>(null),[paused,setPaused]=useState(false),[inPlace,setInPlace]=useState(true),[report,setReport]=useState<PlaybackReport>({state:'DORMANT',message:'La presencia está apareciendo…'});
 const onReady=useCallback(()=>setReady(true),[]);const onReport=useCallback((value:PlaybackReport)=>setReport(old=>({...old,...value})),[]);
 const play=()=>{setPaused(false);setRequest(old=>({source,serial:(old?.serial??0)+1,inPlace}))};const playing=report.state==='PLAYING'||report.state==='RETURNING';
 return <main className={styles.room}><header className={styles.header}><Link href="/poema-universal">POEMA UNIVERSAL</Link><span>ESTUDIO DE PRESENCIA · 01—02</span></header><div className={styles.title}><span>EL POEMA YA HA COMENZADO.</span><h1>Cuerpo vivo.</h1><p>Una escultura que ha empezado a vivir.</p></div><div className={styles.stage} role="img" aria-label="Gran Avatar de cuerpo entero, escultura dorada con esqueleto articulado"><SceneBoundary><Scene onReady={onReady} request={request} paused={paused} onReport={onReport}/></SceneBoundary></div><div className={styles.controls}><p className={styles.playbackStatus} role="status" data-playback-state={report.state}>{paused?'El gesto queda en suspenso.':report.message}</p><div className={styles.controlRow}><label className={styles.clipLabel}>Movimiento<select value={source} onChange={e=>setSource(Number(e.target.value))}>{AVATAR_SOURCE_FILES.map((file,i)=><option key={file} value={i}>{i<8?`Estudio ${String(i+1).padStart(2,'0')} · ${file.split('Animation_')[1].slice(0,8)}`:i===8?'Walking':'Running'}</option>)}</select></label><button onClick={play} disabled={!ready||report.state==='LOADING'}>Reproducir gesto</button><button onClick={()=>setPaused(p=>!p)} disabled={!playing}>{paused?'Continuar':'Pausar'}</button><button onClick={()=>{setPaused(false);setRequest(null)}} disabled={!request}>Reposo</button></div><details className={styles.inspection}><summary>Registro del movimiento</summary><label className={styles.inPlace}><input type="checkbox" checked={inPlace} onChange={e=>setInPlace(e.target.checked)}/>Mantener posición horizontal en la próxima reproducción</label><p>Se conserva el movimiento vertical. Los nombres de los gestos personalizados aún no están asignados.</p>{report.clips?<ul>{report.clips.map(c=><li key={c.id}><strong>{c.name}</strong> · {c.duration.toFixed(3)} s · {c.tracks} tracks · {c.movingTracks} con movimiento{!c.useful?' · pose estática, descartada':''}</li>)}</ul>:<p>Reproduce un movimiento para inspeccionar sus clips.</p>}</details></div><footer className={styles.footer}>ESTUDIO AISLADO · SIN APORTACIONES NI CONEXIÓN AL ARCHIVO</footer></main>
}
