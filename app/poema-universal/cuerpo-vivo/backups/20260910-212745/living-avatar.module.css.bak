.room{position:relative;min-height:100svh;background:radial-gradient(ellipse at 50% 55%,#242421 0%,#111516 44%,#080d10 80%);color:#e5dccb;isolation:isolate;overflow:hidden;font-family:Arial,sans-serif}.header{position:absolute;left:5%;right:5%;top:32px;z-index:2;display:flex;justify-content:space-between;gap:24px;font-size:12px;letter-spacing:2px}.header a{color:#d6c3a0;text-decoration:none}.header span{color:#839091}.title{position:absolute;left:7%;top:22%;z-index:2;max-width:260px;pointer-events:none}.title>span{font-size:11px;letter-spacing:1.8px;color:#a9997e}.title h1{font:normal clamp(36px,4vw,60px)/1.1 Georgia,serif;letter-spacing:-1.8px;margin:22px 0}.title p{font:italic 18px/1.6 Georgia,serif;color:#979f9b}.stage{height:100svh;min-height:620px;width:100%;position:relative}.stage canvas{outline:none}.status{position:absolute;bottom:115px;left:0;right:0;text-align:center;font:italic 18px Georgia,serif;color:#c5b796;pointer-events:none}.footer{position:absolute;bottom:40px;left:5%;right:5%;text-align:center;font-size:10px;letter-spacing:1.7px;color:#778584}.failure{position:absolute;inset:35% 10%;text-align:center}.failure button{background:#c7b18a;color:#151c20;border:0;padding:12px 20px;border-radius:6px;cursor:pointer}.room button:focus-visible,.room a:focus-visible{outline:2px solid #dbc798;outline-offset:5px}@media(max-width:720px){.header{top:24px;font-size:10px;letter-spacing:1px}.header span{max-width:100px;text-align:right}.title{top:85px;left:0;right:0;text-align:center;max-width:none}.title h1{font-size:35px;margin:12px 0}.title p{display:none}.title>span{font-size:10px}.stage{min-height:660px}.status{bottom:105px;font-size:16px}.footer{bottom:65px;font-size:9px;letter-spacing:1px}}
.controls{position:absolute;bottom:66px;left:0;right:0;z-index:3;display:flex;flex-direction:column;align-items:center;gap:14px}.playbackStatus{font:italic 17px Georgia,serif;margin:0;color:#cbb998}.controlRow{display:flex;align-items:end;justify-content:center;gap:10px}.controlRow button{color:#ddcbb0;background:#182020d9;border:1px solid #b9a47e40;border-radius:7px;padding:11px 15px;cursor:pointer;font-size:13px;min-height:43px}.controlRow button:first-of-type{background:#d1bd95;color:#171e20}.controlRow button:disabled{opacity:.35;cursor:default}.clipLabel{font-size:11px;color:#a9a797;display:flex;flex-direction:column;gap:5px}.clipLabel select{color:#d2c7b6;background:#142020;border:1px solid #b9a47e40;border-radius:7px;padding:11px;font:13px Arial,sans-serif;max-width:220px}.inspection{font-size:12px;color:#acafa5;max-width:min(610px,90vw)}.inspection summary{cursor:pointer;text-align:center;color:#959b92}.inspection[open]{background:#101918f5;border:1px solid #8b805055;padding:18px;border-radius:10px;position:absolute;bottom:0;max-height:280px;overflow:auto;box-shadow:0 10px 70px #0009}.inspection p{line-height:1.6;font-size:12px}.inspection ul{padding-left:18px;line-height:1.7}.inPlace{display:flex;gap:8px;align-items:center;margin:18px 0 8px}.inPlace input{accent-color:#c7b18a}.room select:focus-visible,.room summary:focus-visible{outline:2px solid #dbc798;outline-offset:3px}@media(max-width:720px){.controls{bottom:96px;gap:10px}.controlRow{flex-wrap:wrap;gap:7px;max-width:360px;padding:0 10px}.clipLabel{width:100%;align-items:center;flex-direction:row;justify-content:center;gap:10px}.controlRow button{padding:9px 12px;font-size:12px;min-height:40px}.playbackStatus{font-size:14px}.stage{min-height:760px}.footer{bottom:65px}.inspection[open]{bottom:0}.title{top:80px}}
