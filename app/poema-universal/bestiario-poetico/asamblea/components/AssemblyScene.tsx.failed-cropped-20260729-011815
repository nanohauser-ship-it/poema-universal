function fitModelToBox(
  source: Group,
  targetSize: number
) {
  const model = source.clone(true);

  model.position.set(0, 0, 0);
  model.rotation.set(0, 0, 0);
  model.scale.setScalar(1);
  model.updateMatrixWorld(true);

  const initialBox = new Box3().setFromObject(model);
  const size = new Vector3();
  const center = new Vector3();

  initialBox.getSize(size);
  initialBox.getCenter(center);

  const maxDimension = Math.max(
    size.x,
    size.y,
    size.z
  );

  if (!Number.isFinite(maxDimension) || maxDimension <= 0) {
    return model;
  }

  const uniformScale = targetSize / maxDimension;
  model.scale.setScalar(uniformScale);
  model.updateMatrixWorld(true);

  const scaledBox = new Box3().setFromObject(model);
  const scaledCenter = new Vector3();
  scaledBox.getCenter(scaledCenter);

  model.position.x -= scaledCenter.x;
  model.position.z -= scaledCenter.z;
  model.position.y -= scaledBox.min.y;

  model.updateMatrixWorld(true);

  model.traverse((child) => {
    const mesh = child as Mesh;

    if (!mesh.isMesh) return;

    mesh.castShadow = true;
    mesh.receiveShadow = true;

    if (Array.isArray(mesh.material)) {
      mesh.material = mesh.material.map((mat) => {
        mat.needsUpdate = true;
        return mat;
      });
    } else if (mesh.material) {
      mesh.material.needsUpdate = true;
    }
  });

  return model;
}

function Creature({
  config,
  active,
}: {
  config: CreatureConfig;
  active: boolean;
}) {
  const gltf = useGLTF(config.path);
  const group = useRef<Group>(null);

  const fitted = useMemo(
    () =>
      fitModelToBox(
        gltf.scene,
        config.targetSize
      ),
    [gltf.scene, config.targetSize]
  );

  useFrame((state, delta) => {
    if (!group.current) return;

    const t = state.clock.getElapsedTime();
    const lift = active ? 0.12 : 0.04;
    const bob = Math.sin(t * 1.2 + config.position[0]) * lift;
    const targetRot =
      config.rotationY +
      (active ? Math.sin(t * 0.8) * 0.08 : 0);

    group.current.position.y = MathUtils.lerp(
      group.current.position.y,
      bob,
      0.08
    );

    group.current.rotation.y = MathUtils.lerp(
      group.current.rotation.y,
      targetRot,
      0.08
    );
  });

  return (
    <group
      ref={group}
      position={config.position}
    >
      <mesh
        rotation={[-Math.PI / 2, 0, 0]}
        position={[0, 0.02, 0]}
        receiveShadow
      >
        <ringGeometry args={[0.86, 1.18, 64]} />
        <meshBasicMaterial
          color={
            active
              ? DOMAIN_TINT[config.id]
              : "#6d5631"
          }
          transparent
          opacity={active ? 0.85 : 0.26}
          blending={AdditiveBlending}
        />
      </mesh>

      <primitive object={fitted} />
    </group>
  );
}

