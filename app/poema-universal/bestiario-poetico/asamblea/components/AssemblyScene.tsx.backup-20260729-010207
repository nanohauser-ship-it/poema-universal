}

function RitualVortex({
  ritualActive,
  activeDomain,
}: {
  ritualActive: boolean;
  activeDomain:
    | AssemblyDomain
    | null;
}) {
  const outer =
    useRef<Group>(null);

  const middle =
    useRef<Group>(null);

  const inner =
    useRef<Group>(null);

  const core =
    useRef<Mesh>(null);

  useFrame(
    ({ clock }, delta) => {
      const speed =
        ritualActive
          ? activeDomain
            ? 0.62
            : 1.12
          : 0.08;

      if (outer.current) {
        outer.current.rotation.y +=
          delta * speed;

        outer.current.rotation.z +=
          delta *
          speed *
          0.12;
      }

      if (middle.current) {
        middle.current.rotation.y -=
          delta *
          speed *
          1.3;

        middle.current.rotation.x +=
          delta *
          speed *
          0.09;
      }

      if (inner.current) {
        inner.current.rotation.z +=
          delta *
          speed *
          1.6;
      }

      if (core.current) {
        const pulse =
          ritualActive
            ? 1 +
              Math.sin(
                clock.elapsedTime *
                  2.8
              ) *
                0.1
            : 0.7 +
              Math.sin(
                clock.elapsedTime
              ) *
                0.035;

        core.current.scale.setScalar(
          pulse
        );
      }
    }
  );

  const opacity =
    ritualActive
      ? 0.42
      : 0.07;

  return (
    <group
      position={[0, 0.82, 0]}
      scale={
        ritualActive
          ? 0.84
          : 0.56
      }
    >
      <group ref={outer}>
        <mesh
          rotation={[
            0.96,
            0.18,
            0.28,
          ]}
        >
          <torusGeometry
            args={[
              0.8,
              0.012,
              10,
              128,
            ]}
          />

          <meshBasicMaterial
            color="#e5b965"
            transparent
            opacity={opacity}
            depthWrite={false}
          />
        </mesh>

        <mesh
          rotation={[
            -0.72,
            0.48,
            -0.36,
          ]}
        >
          <torusGeometry
            args={[
              0.63,
              0.009,
              10,
              112,
            ]}
          />

          <meshBasicMaterial
            color="#f6dfac"
            transparent
            opacity={
              opacity * 0.72
            }
            depthWrite={false}
          />
        </mesh>
      </group>

      <group ref={middle}>
        <mesh
          rotation={[
            Math.PI / 2,
            0.7,
            0,
          ]}
        >
          <torusGeometry
            args={[
              0.44,
              0.016,
              10,
              96,
            ]}
          />

          <meshBasicMaterial
            color="#cb8332"
            transparent
            opacity={
              opacity * 0.82
            }
            depthWrite={false}
          />
        </mesh>
      </group>

      <group ref={inner}>
        <mesh
          rotation={[
            0.4,
            0.9,
            Math.PI / 2,
          ]}
        >
          <torusGeometry
            args={[
              0.25,
              0.019,
              10,
              72,
            ]}
          />

          <meshBasicMaterial
            color="#ffd587"
            transparent
            opacity={
              opacity * 0.92
            }
            depthWrite={false}
          />
        </mesh>
      </group>

      <mesh
        ref={core}
        position={[0, -0.02, 0]}
      >
        <icosahedronGeometry
          args={[0.11, 2]}
        />

        <meshStandardMaterial
          color="#ffe8b6"
          emissive="#d98a31"
          emissiveIntensity={
            ritualActive
              ? 2.1
              : 0.32
          }
          roughness={0.3}
          transparent
          opacity={
            ritualActive
              ? 0.82
              : 0.25
          }
        />
      </mesh>

      <mesh
        position={[0, -0.52, 0]}
      >
        <cylinderGeometry
          args={[
            0.07,
            0.3,
            1.15,
            40,
            1,
            true,
          ]}
        />

        <meshBasicMaterial
          color="#d79942"
          transparent
          opacity={
            ritualActive
              ? 0.055
              : 0.01
          }
          side={DoubleSide}
          depthWrite={false}
        />
      </mesh>

      {ritualActive && (
        <Sparkles
          count={
            activeDomain
              ? 34
              : 56
          }
          scale={[
            1.7,
            1.85,
            1.7,
          ]}
          size={1.55}
          speed={
            activeDomain
              ? 0.42
              : 0.72
          }
          opacity={0.52}
          color="#efc177"
        />
      )}

      <pointLight
        position={[0, 0, 0]}
        intensity={
          ritualActive
            ? 2.1
            : 0.25
        }
        distance={5.2}
        color="#e7aa53"
      />
    </group>
  );
}

