function normalizeModel(
  model: Object3D,
  targetHeight: number
) {
  model.position.set(0, 0, 0);
  model.rotation.set(0, 0, 0);
  model.scale.setScalar(1);

  const initialBox =
    new Box3().setFromObject(model);

  const initialSize =
    new Vector3();

  initialBox.getSize(initialSize);

  if (
    !Number.isFinite(
      initialSize.y
    ) ||
    initialSize.y <= 0
  ) {
    return;
  }

  const scale =
    targetHeight /
    initialSize.y;

  model.scale.setScalar(scale);

  const scaledBox =
    new Box3().setFromObject(model);

  const scaledCenter =
    new Vector3();

  scaledBox.getCenter(
    scaledCenter
  );

  model.position.x -=
    scaledCenter.x;

  model.position.z -=
    scaledCenter.z;

  model.position.y -=
    scaledBox.min.y;
}

function prepareModel(
  source: Object3D,
  targetHeight: number
) {
  const clone =
    source.clone(true);

  normalizeModel(
    clone,
    targetHeight
  );

  clone.traverse(
    (object) => {
      if (
        !(object instanceof Mesh)
      ) {
        return;
      }

      object.castShadow = true;
      object.receiveShadow = true;

      const materials =
        Array.isArray(
          object.material
        )
          ? object.material
          : [object.material];

      const clonedMaterials =
        materials.map(
          (material) => {
            const cloned =
              material.clone();

            if (
              cloned instanceof
              MeshStandardMaterial
            ) {
              cloned.roughness =
                Math.min(
                  0.92,
                  cloned.roughness +
                    0.06
                );

              cloned.metalness =
                Math.min(
                  0.7,
                  cloned.metalness
                );
            }

            return cloned;
          }
        );

      object.material =
        Array.isArray(
          object.material
        )
          ? clonedMaterials
          : clonedMaterials[0];
    }
  );

  return clone;
}

function RealCreature({
  path,
  domain,
  position,
  rotation,
  targetHeight,
  activeDomain,
  ritualActive,
}: CreatureProps) {
  const gltf = useGLTF(path);

  const group =
    useRef<Group>(null);

  const model = useMemo(
    () =>
      prepareModel(
        gltf.scene,
        targetHeight
      ),
    [
      gltf.scene,
      targetHeight,
    ]
  );

  const active =
    activeDomain === domain;

  useEffect(() => {
    model.traverse(
      (object) => {
        if (
          !(object instanceof Mesh)
        ) {
          return;
        }

        const materials =
          Array.isArray(
            object.material
          )
            ? object.material
            : [object.material];

        materials.forEach(
          (material) => {
            if (
              material instanceof
              MeshStandardMaterial
            ) {
              material.emissive.set(
                domainColors[domain]
              );

              material.emissiveIntensity =
                active
                  ? 0.16
                  : ritualActive
                    ? 0.028
                    : 0.008;
            }
          }
        );
      }
    );
  }, [
    model,
    domain,
    active,
    ritualActive,
  ]);

  useFrame(
    ({ clock }) => {
      if (!group.current) {
        return;
      }

      const breathing =
        Math.sin(
          clock.elapsedTime *
            0.72 +
            position[0] +
            position[2]
        ) *
        0.007;

      const activeScale =
        active ? 1.04 : 1;

      group.current.scale.setScalar(
        activeScale + breathing
      );

      group.current.position.y =
        position[1] +
        Math.sin(
          clock.elapsedTime *
            0.48 +
            position[0]
        ) *
          0.018;
    }
  );

  return (
    <group
      ref={group}
      position={position}
      rotation={rotation}
    >
      <primitive
        object={model}
      />

      <pointLight
        position={[0, 1.15, 0.8]}
        intensity={
          active
            ? 3.2
            : ritualActive
              ? 0.72
              : 0.3
        }
        distance={4.8}
        color={
          domainColors[domain]
        }
      />
    </group>
  );
}

