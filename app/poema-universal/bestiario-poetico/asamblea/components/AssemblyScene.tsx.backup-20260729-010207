        />

        <meshStandardMaterial
          color={
            ritualActive
              ? "#f5e5c6"
              : "#cdb895"
          }
          emissive={
            ritualActive
              ? "#9f6828"
              : "#3e2b18"
          }
          emissiveIntensity={
            ritualActive
              ? 0.42
              : 0.1
          }
          roughness={0.92}
          metalness={0}
