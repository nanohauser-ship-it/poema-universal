  inset: 0;

  z-index: 1000;

  display: grid;
  place-items: center;

  padding: 4vh 4vw;

  background:
    radial-gradient(
      circle at 50% 50%,
      rgba(95, 59, 14, .11),
      rgba(0, 0, 0, .93) 60%
    );

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}


/* =========================================================
   ESTACIÓN DE CAPTURA
========================================================= */

.recorder-studio {
  position: relative;

  width: min(760px, 92vw);

  max-height: 92vh;

  overflow-y: auto;

  padding: 30px 34px 28px;

  border:
    1px solid rgba(224, 170, 75, .28);

  background:
    linear-gradient(
      150deg,
      rgba(13, 9, 4, .98),
      rgba(3, 3, 2, .99)
    );

  color: rgba(238, 217, 177, .75);

  box-shadow:
    0 40px 120px rgba(0, 0, 0, .92),
    inset 0 0 85px rgba(207, 138, 35, .025);
}

.recorder-studio::before {
  content: "";

  position: absolute;

  left: 50%;
  top: -1px;

  width: 90px;
  height: 1px;

  transform: translateX(-50%);

  background:
    rgba(248, 204, 122, .82);

  box-shadow:
    0 0 18px rgba(234, 167, 59, .55);
}


/* =========================================================
   CABECERA
========================================================= */

.recorder-header {
  display: flex;
  justify-content: space-between;
  gap: 24px;

  padding-bottom: 22px;

  border-bottom:
    1px solid rgba(218, 164, 73, .11);
}

.recorder-header p {
  margin: 0 0 8px;

  color: rgba(220, 165, 74, .55);

  font-size: 6px;
  letter-spacing: .45em;
}

.recorder-header h2 {
  margin: 0;

  color: rgba(246, 226, 190, .94);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(28px, 2.5vw, 42px);

  font-weight: 400;
}

.recorder-header span {
  display: block;

  margin-top: 8px;

  color: rgba(229, 204, 162, .42);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 12px;
  font-style: italic;
}

.recorder-close {
  width: 34px;
  height: 34px;

  flex: 0 0 auto;

  border:
    1px solid rgba(220, 166, 74, .2);

  border-radius: 50%;

  background: transparent;

  color: rgba(239, 205, 147, .57);

  cursor: pointer;

  font-size: 18px;
}


/* =========================================================
   DISPOSITIVO DE AUDIO
========================================================= */

.recorder-device {
  display: grid;
  grid-template-columns: auto 1fr;

  align-items: center;
  gap: 20px;

  margin-top: 22px;
}

.recorder-device label {
  color: rgba(221, 175, 91, .43);

  font-size: 6px;
  letter-spacing: .34em;
}

.recorder-device select {
  width: 100%;

  padding: 10px 12px;

  border:
    1px solid rgba(219, 164, 72, .17);

  outline: none;

  background: #070603;

  color: rgba(240, 217, 174, .7);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 12px;
}


/* =========================================================
   ORBE DE GRABACIÓN
========================================================= */

.recorder-orb {
  position: relative;

  width: 190px;
  height: 190px;

  margin: 28px auto 10px;

  display: grid;
  place-items: center;
}

.recorder-orb-ring {
  position: absolute;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%);

  border-radius: 50%;

  border:
    1px solid rgba(220, 166, 73, .16);
}

.recorder-orb .ring-one {
  width: 100%;
  height: 100%;
}

.recorder-orb .ring-two {
  width: 72%;
  height: 72%;
}

.recorder-orb .ring-three {
  width: 45%;
  height: 45%;
}

.recorder-core {
  position: relative;

  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  border:
    1px solid rgba(231, 180, 87, .35);

  background:
    radial-gradient(
      circle,
      rgba(197, 125, 24, .12),
      rgba(4, 3, 1, .8)
    );

  box-shadow:
    0 0 30px rgba(214, 142, 33, .08);
}

.record-dot {
  width: 10px;
  height: 10px;

  border-radius: 50%;

  background: #9f392a;

  box-shadow:
    0 0 15px rgba(179, 54, 39, .55);
}

.recorder-orb.is-recording .record-dot {
  background: #e0553d;

  box-shadow:
    0 0 22px rgba(225, 73, 48, .9);

  animation:
    recorderPulse 1.15s ease-in-out infinite;
}

.recorder-orb.is-recording .ring-one {
  animation:
    recorderRing 2.4s ease-out infinite;
}

.recorder-orb.is-recording .ring-two {
  animation:
    recorderRing 2.4s .55s ease-out infinite;
}

.recorder-orb.is-recording .ring-three {
  animation:
    recorderRing 2.4s 1.1s ease-out infinite;
}


/* =========================================================
   TIEMPO
========================================================= */

.recorder-time {
  text-align: center;

  color: rgba(241, 211, 157, .67);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 21px;

  letter-spacing: .1em;
}


/* =========================================================
   BOTÓN GRABAR
========================================================= */

.recorder-main-button {
  display: block;

  min-width: 240px;

  margin: 17px auto 24px;

  padding: 12px 18px;

  border:
    1px solid rgba(218, 163, 70, .34);

  background:
    rgba(18, 12, 4, .6);

  color: rgba(243, 213, 158, .76);

  cursor: pointer;

  font-size: 7px;
  letter-spacing: .28em;

  transition:
    border-color 250ms ease,
    color 250ms ease;
}

.recorder-main-button:hover {
  border-color:
    rgba(246, 204, 126, .72);

  color: #f8dfae;
}

.recorder-main-button.recording {
  border-color:
    rgba(178, 70, 48, .55);

  color:
    rgba(239, 156, 134, .85);
}


/* =========================================================
   PREVISUALIZACIÓN
========================================================= */

.recording-preview {
  margin: 18px 0 25px;

  padding: 18px;

  border:
    1px solid rgba(220, 165, 73, .13);

  background:
    rgba(255, 255, 255, .01);
}

.recording-preview > p {
  margin: 0 0 12px;

  color: rgba(221, 172, 82, .45);

  font-size: 6px;
  letter-spacing: .34em;
}

.recording-preview audio {
  width: 100%;
}

.recording-preview-actions {
  margin-top: 10px;

  text-align: right;
}

.recording-preview-actions button {
  border: 0;
  background: transparent;

  color: rgba(225, 177, 91, .5);

  cursor: pointer;

  font-size: 6px;
  letter-spacing: .27em;
}


/* =========================================================
   METADATOS
========================================================= */

.recorder-metadata {
  display: grid;

  grid-template-columns:
    1fr 1fr 1fr;

  gap: 14px;
}

.recorder-metadata label {
  display: flex;
  flex-direction: column;

  gap: 7px;

  color: rgba(220, 177, 94, .4);

  font-size: 6px;
  letter-spacing: .27em;
}

.recorder-metadata input,
.recorder-metadata textarea {
  width: 100%;

  padding: 9px 0;

  border: 0;

  border-bottom:
    1px solid rgba(219, 165, 73, .17);

  outline: none;

  background: transparent;

  color: rgba(242, 222, 187, .78);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 13px;

  resize: vertical;
}

.recorder-metadata input:focus,
.recorder-metadata textarea:focus {
  border-bottom-color:
    rgba(238, 190, 101, .58);
}

.recorder-excerpt {
  grid-column: 1 / -1;
}


/* =========================================================
   ERROR
========================================================= */

.recorder-error {
  margin: 16px 0 0;

  color: rgba(226, 140, 112, .82);

  font-size: 10px;
}


/* =========================================================
   FOOTER
========================================================= */

.recorder-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 20px;

  margin-top: 25px;

  padding-top: 21px;

  border-top:
    1px solid rgba(218, 164, 73, .1);
}

.recorder-footer > span {
  color: rgba(218, 184, 120, .28);

  font-size: 5px;
  letter-spacing: .27em;
}

.recorder-save {
  padding: 11px 16px;

  border:
    1px solid rgba(224, 170, 76, .39);

  background:
    linear-gradient(
      90deg,
      rgba(8, 5, 2, .7),
      rgba(37, 23, 6, .58),
      rgba(8, 5, 2, .7)
    );

  color: rgba(245, 217, 164, .78);

  cursor: pointer;

  font-size: 7px;
  letter-spacing: .27em;
}

.recorder-save:disabled {
  opacity: .28;

  cursor: default;
}


/* =========================================================
   ANIMACIONES
========================================================= */

@keyframes recorderPulse {
  0%,
  100% {
    transform: scale(.82);
    opacity: .68;
  }

  50% {
    transform: scale(1.18);
    opacity: 1;
  }
}

@keyframes recorderRing {
  0% {
    transform:
      translate(-50%, -50%)
      scale(.82);

    opacity: .7;
  }

  100% {
    transform:
      translate(-50%, -50%)
      scale(1.22);

    opacity: .04;
  }
}


/* =========================================================
   MÓVIL
========================================================= */

@media (max-width: 820px) {

  .top-actions {
    gap: 12px;
  }

  .record-top,
  .add-top {
    font-size: 6px;
  }

  .recorder-studio {
    padding:
      23px 20px;
  }

  .recorder-device {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .recorder-metadata {
    grid-template-columns: 1fr;
  }

  .recorder-excerpt {
    grid-column: auto;
  }

  .recorder-footer {
    flex-direction: column;

    align-items: stretch;
  }

  .recorder-save {
    width: 100%;
  }
}



/* =========================================================
   CORO DE LA TIERRA
   REPARACIÓN ARCHIVO CORAL + NAVEGACIÓN DE VOCES
========================================================= */


/* =========================================================
   BOTÓN: VER TODAS LAS VOCES
========================================================= */

.all-voices-button {
  display: inline-flex;
  align-items: center;

  margin-top: 11px;
  padding: 0;

  border: 0;
  background: transparent;

  color: rgba(226, 181, 100, .48);

  cursor: pointer;

  font-size: 6px;
  letter-spacing: .28em;

  text-transform: uppercase;

  transition:
    color 250ms ease,
    text-shadow 250ms ease;
}

.all-voices-button::after {
  content: "→";

  margin-left: 9px;

  color: rgba(239, 193, 105, .64);

  transition: transform 250ms ease;
}

.all-voices-button:hover {
  color: rgba(250, 221, 166, .88);

  text-shadow:
    0 0 12px rgba(225, 157, 50, .18);
}

.all-voices-button:hover::after {
  transform: translateX(3px);
}


/* =========================================================
   NAVEGACIÓN ENTRE VOCES
========================================================= */

.voice-navigation {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  margin-bottom: 10px;

  color: rgba(218, 170, 84, .43);

  font-size: 6px;
  letter-spacing: .27em;
}

.voice-navigation button {
  display: grid;
  place-items: center;

  width: 24px;
  height: 24px;

  padding: 0;

  border:
    1px solid rgba(218, 166, 74, .18);

  border-radius: 50%;

  background: transparent;

  color: rgba(239, 198, 120, .53);

  cursor: pointer;

  transition:
    border-color 250ms ease,
    color 250ms ease,
    box-shadow 250ms ease;
}

.voice-navigation button:hover {
  color: rgba(255, 228, 172, .9);

  border-color:
    rgba(239, 190, 101, .55);

  box-shadow:
    0 0 16px rgba(220, 151, 43, .09);
}


/* =========================================================
   TRADUCCIÓN DE UNA VOZ
========================================================= */

.voice-translation {
  margin: 13px 0 0;

  padding-top: 11px;

  border-top:
    1px solid rgba(216, 163, 71, .09);

  color: rgba(226, 204, 164, .43);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 10px;
  font-style: italic;

  line-height: 1.5;
}

.voice-translation span {
  display: block;

  margin-bottom: 5px;

  color: rgba(213, 159, 69, .42);

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Helvetica Neue",
    Arial,
    sans-serif;

  font-size: 5px;
  font-style: normal;

  letter-spacing: .34em;
}


/* =========================================================
   OSCURECIMIENTO DEL ARCHIVO CORAL
========================================================= */

.archive-scrim {
  position: fixed;
  inset: 0;

  z-index: 600;

  border: 0;
  background:
    radial-gradient(
      circle at 78% 50%,
      rgba(114, 70, 14, .07),
      rgba(0, 0, 0, .88) 55%
    );

  cursor: default;

  backdrop-filter: blur(9px);
  -webkit-backdrop-filter: blur(9px);

  animation:
    archiveScrimIn
    320ms ease both;
}


/* =========================================================
   ARCHIVO CORAL
========================================================= */

.voice-archive {
  position: fixed;

  top: 0;
  right: 0;
  bottom: 0;

  z-index: 610;

  width: min(440px, 92vw);

  padding: 42px 34px 30px;

  overflow-y: auto;

  border-left:
    1px solid rgba(225, 172, 77, .19);

  background:
    linear-gradient(
      155deg,
      rgba(13, 9, 4, .98),
      rgba(2, 2, 1, .995) 62%
    );

  color: rgba(239, 216, 176, .74);

  box-shadow:
    -30px 0 100px rgba(0, 0, 0, .72),
    inset 20px 0 70px rgba(208, 137, 32, .018);

  animation:
    archivePanelIn
    420ms cubic-bezier(.22,.8,.25,1) both;
}


/* línea de luz superior */

.voice-archive::before {
  content: "";

  position: absolute;

  left: 34px;
  top: 0;

  width: 72px;
  height: 1px;

  background:
    rgba(249, 207, 127, .82);

  box-shadow:
    0 0 17px rgba(237, 169, 60, .58);
}


/* =========================================================
   CABECERA ARCHIVO
========================================================= */

.voice-archive > header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 27px;
  padding-bottom: 22px;

  border-bottom:
    1px solid rgba(218, 164, 73, .11);
}

.voice-archive > header p {
  margin: 0 0 7px;

  color: rgba(218, 164, 73, .52);

  font-size: 6px;
  letter-spacing: .44em;
}

.voice-archive > header h2 {
  margin: 0;

  color: rgba(247, 226, 189, .94);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(26px, 2vw, 36px);

  font-weight: 400;
  letter-spacing: .03em;
}

.voice-archive > header > button {
  display: grid;
  place-items: center;

  flex: 0 0 auto;

  width: 34px;
  height: 34px;

  padding: 0;

  border:
    1px solid rgba(220, 167, 75, .20);

  border-radius: 50%;

  background: transparent;

  color: rgba(239, 207, 151, .57);

  cursor: pointer;

  font-size: 18px;

  transition:
    color 250ms ease,
    border-color 250ms ease,
    transform 250ms ease;
}

.voice-archive > header > button:hover {
  color: #f6dca6;

  border-color:
    rgba(241, 193, 103, .55);

  transform: rotate(6deg);
}


/* =========================================================
   LISTA DE VOCES
========================================================= */

.voice-archive-list {
  display: flex;
  flex-direction: column;

  gap: 0;
}

.voice-archive-list > button {
  position: relative;

  width: 100%;

  display: grid;
  grid-template-columns:
    35px 1fr;

  column-gap: 13px;

  padding: 16px 5px 16px 0;

  border: 0;
  border-bottom:
    1px solid rgba(216, 164, 72, .075);

  background: transparent;

  color: inherit;

  text-align: left;

  cursor: pointer;

  transition:
    background 250ms ease,
    padding-left 250ms ease;
}

.voice-archive-list > button::before {
  content: "";

  position: absolute;

  left: -34px;
  top: 50%;

  width: 0;
  height: 1px;

  transform: translateY(-50%);

  background:
    rgba(242, 190, 98, .68);

  box-shadow:
    0 0 9px rgba(222, 151, 43, .35);

  transition:
    width 280ms ease;
}

.voice-archive-list > button:hover {
  padding-left: 5px;

  background:
    linear-gradient(
      90deg,
      rgba(207, 135, 29, .035),
      transparent
    );
}

.voice-archive-list > button:hover::before,
.voice-archive-list > button.is-selected::before {
  width: 25px;
}

.voice-archive-list > button.is-selected {
  background:
    linear-gradient(
      90deg,
      rgba(211, 140, 31, .06),
      transparent 70%
    );
}


/* número */

.voice-archive-list > button > span {
  grid-row: 1 / 3;

  align-self: start;

  padding-top: 2px;

  color: rgba(219, 168, 80, .38);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 13px;
}


/* nombre */

.voice-archive-list > button strong {
  color: rgba(242, 220, 179, .76);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 17px;
  font-weight: 400;

  letter-spacing: .02em;
}

.voice-archive-list > button.is-selected strong {
  color: rgba(251, 229, 187, .98);
}


/* lugar / idioma */

.voice-archive-list > button small {
  margin-top: 4px;

  color: rgba(225, 197, 142, .33);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 9px;
  font-style: italic;

  line-height: 1.35;
}


/* =========================================================
   CAMPOS DE AUDIO SUBIDOS
========================================================= */

.draft-fields {
  min-width: 0;

  display: flex;
  flex-direction: column;
}


/* =========================================================
   ANIMACIONES DEL ARCHIVO
========================================================= */

@keyframes archiveScrimIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes archivePanelIn {
  from {
    opacity: 0;

    transform:
      translateX(35px);
  }

  to {
    opacity: 1;

    transform:
      translateX(0);
  }
}


/* =========================================================
   MÓVIL
========================================================= */

@media (max-width: 820px) {

  .voice-archive {
    width: 100%;

    padding:
      30px 22px 25px;
  }

  .voice-archive::before {
    left: 22px;
  }

  .voice-archive-list > button::before {
    left: -22px;
  }
}

